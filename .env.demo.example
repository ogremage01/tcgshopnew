# 서버 배포 디렉터리: /var/www/html/tcgshop
# 사용: 이 파일을 /var/www/html/tcgshop/.env 로 복사한 뒤 값을 수정
#       cd /var/www/html/tcgshop && docker compose -f docker-compose.demo.yml up -d --build

DEPLOY_ROOT=/var/www/html/tcgshop
HTTP_PORT=80

SPRING_PROFILES_ACTIVE=demo

DB_URL=jdbc:mariadb://DB호스트:3306/shop?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-characters-long-secret
PERSONAL_DATA_ENCRYPTION_KEY=change-me-base64-32-bytes

# 사이트 도메인 (CORS·sitemap/robots)
CORS_ORIGINS=https://tcgshop.example
NEXT_PUBLIC_SITE_URL=https://tcgshop.example

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
GOOGLE_MAIL_ADDRESS=
GOOGLE_MAIL_PASSWORD=
