# Backend API URL (브라우저 CSR, rewrite 미사용 시)
# NEXT_PUBLIC_API_URL=http://localhost:1567

# 자산(이미지) 베이스 URL — CDN 또는 정적 파일 오리진 (미설정 시 NEXT_PUBLIC_API_URL → 동일 오리진)
# NEXT_PUBLIC_ASSET_BASE_URL=https://cdn.example.com

# SSR/API Route 전용 (Node fetch, Docker frontend 서비스명 예: http://backend:1567)
# API_SERVER_URL=http://localhost:1567

# 사이트 URL (sitemap/robots 절대 URL용)
NEXT_PUBLIC_SITE_URL=https://tcgshop.example

# 우편번호 서비스 API 키 (Next.js API Route 프록시 전용)
POSTAL_CODE_SERVICE_API_KO_KEY=
POSTAL_CODE_SERVICE_API_EN_KEY=

# Toss Payments (클라이언트 SDK — NEXT_PUBLIC_ 필수)
# customerKey는 User.publicId(ULID)를 사용하므로 env에 두지 않음
# 로컬(next dev): 이 파일 또는 .env.local 에 test_gck_...
# 이 공개 저장소에서는 테스트 키만 사용하세요.
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=

# International Card Payment (클라이언트 SDK — NEXT_PUBLIC_ 필수)
NEXT_PUBLIC_INTERNATIONAL_CARD_PAYMENT_CLIENT_KEY=

