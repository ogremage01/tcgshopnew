# 운영 이미지 빌드용 (git 무시: frontend/.env.production 으로 복사 후 값 입력)
#   cp frontend/.env.production.example frontend/.env.production
#
# 통합/분리 Docker 이미지는 이 파일만 빌드 입력으로 사용합니다.
# NEXT_PUBLIC_* : next build / Docker 빌드 시점에 번들에 박힘 (서버 런타임 .env 만으로는 안 바뀜)
# POSTAL_CODE_* : 서버 전용(브라우저 비노출). 통합 Docker는 compose 런타임 주입도 가능

# 사이트 URL (sitemap/robots 절대 URL용)
NEXT_PUBLIC_SITE_URL=https://tcgshop.example

# 우편번호 서비스 API 키 (Next.js API Route 프록시 전용)
POSTAL_CODE_SERVICE_API_KO_KEY=
POSTAL_CODE_SERVICE_API_EN_KEY=

# Toss Payments — 결제위젯(widgets)용. 이 공개본은 test_gck_ 만 사용합니다.
# API 개별 연동 키(live_ck_ / test_ck_)를 넣으면 "API 개별 연동 키는 지원하지 않습니다" 오류
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=

# International Card — payment() API용. 미사용이면 비워 둡니다.
# API 개별 연동 키(live_ck_ / test_ck_)만 허용
NEXT_PUBLIC_INTERNATIONAL_CARD_PAYMENT_CLIENT_KEY=
