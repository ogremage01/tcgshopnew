# 시연·스테이징 서버 (SPRING_PROFILES_ACTIVE=demo)
# Docker 통합 배포 시 프로젝트 루트의 .env.demo.example → /var/www/html/tcgshop/.env 권장

DEPLOY_ROOT=/var/www/html/tcgshop
SPRING_PROFILES_ACTIVE=demo
SERVER_PORT=1567

DB_URL=jdbc:mariadb://localhost:3306/shop?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Seoul
DB_USERNAME=shop
DB_PASSWORD=change-me

JWT_SECRET=change-me-to-at-least-32-characters-long-secret
PERSONAL_DATA_ENCRYPTION_KEY=change-me-base64-32-bytes

# 사이트 도메인
CORS_ORIGINS=https://tcgshop.example
NEXT_PUBLIC_SITE_URL=https://tcgshop.example

# 선택
DDL_AUTO=update
STRICT_ORIGIN_CHECK=true
PERMIT_METADATA_WITHOUT_AUTH=true
# 컨테이너 내부 경로 (docker-compose.demo.yml 볼륨 마운트와 동일)
FILE_UPLOAD_PATH=/app/data/uploads/
FILE_CARD_IMAGES=/app/data/card-images/

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
GOOGLE_MAIL_ADDRESS=
GOOGLE_MAIL_PASSWORD=

TOSS_WIDGET_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6
