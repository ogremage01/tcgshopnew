# 운영 통합 이미지 빌드는 frontend/.env.production만 사용합니다.
#   cp frontend/.env.production.example frontend/.env.production
#   docker compose -f docker-compose.yml build --no-cache app
#
# NEXT_PUBLIC_*는 next build 중 브라우저 번들에 고정됩니다.
# 서버 런타임 .env로 변경할 수 없으므로, 키 변경 시 이미지를 다시 빌드·배포하세요.
#
# 아래는 서버 런타임 .env (compose environment) 전용입니다.
# TOSS_WIDGET_SECRET_KEY=test_gsk_...
# POSTAL_CODE_SERVICE_API_KO_KEY=
# POSTAL_CODE_SERVICE_API_EN_KEY=
